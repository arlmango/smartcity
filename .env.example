# SmartCity configuration. Copy to .env and adjust. Never commit .env.
# Values below are safe local defaults; secrets are empty on purpose.

# --- Database (local compose db published on 127.0.0.1:5433)
DATABASE_URL=postgresql+psycopg://smartcity:smartcity@localhost:5433/smartcity
POSTGRES_PASSWORD=smartcity

# --- Public app settings (safe for the browser)
PUBLIC_APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# --- Generation provider: ollama | openai_compatible | none
AI_PROVIDER=ollama
AI_BASE_URL=http://localhost:11434
# Server-only secret. Leave empty for local Ollama.
AI_API_KEY=
AI_MODEL=qwen2.5:3b
AI_TIMEOUT_SECONDS=150

# --- Embedding provider: ollama | openai_compatible | none
EMBEDDING_PROVIDER=ollama
EMBEDDING_BASE_URL=http://localhost:11434
# Server-only secret. Leave empty for local Ollama.
EMBEDDING_API_KEY=
EMBEDDING_MODEL=bge-m3

# --- Data source (read-only Overpass endpoint; respect its usage policy)
OSM_SOURCE_URL=https://maps.mail.ru/osm/tools/overpass/api/interpreter
COVERAGE_CONFIG=config/coverage.geojson
INGEST_CONTACT_USER_AGENT="SmartCity-prototype/0.1 (hackathon demo; bounded Astana extract)"

# --- Routing (optional): none | valhalla
ROUTING_PROVIDER=none
ROUTING_BASE_URL=

# --- City base map (make basemap). Licensing mode of this deployment (code default: commercial, fail-closed):
# noncommercial (this hackathon demo) offers the EOxCloudless satellite underlay (CC BY-NC-SA 4.0) in the
# hybrid view; commercial never loads it (no commercial EOX licence). MAP_SATELLITE=off disables it anyway.
APP_USAGE_MODE=noncommercial
MAP_SATELLITE=auto
RATE_LIMIT_TILES=3000/minute

# --- Operations
LOG_LEVEL=INFO
REQUEST_TIMEOUT_SECONDS=200
RATE_LIMIT=20/minute
DATA_DIR=data

# --- Local Ollama: how long models stay loaded after a request (cold load ~35 s on CPU)
OLLAMA_KEEP_ALIVE=30m
