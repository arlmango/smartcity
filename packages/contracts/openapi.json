{
  "components": {
    "schemas": {
      "AppliedConstraint": {
        "additionalProperties": false,
        "properties": {
          "kind": {
            "enum": [
              "time_budget",
              "return_to_start",
              "walking_only",
              "required_feature",
              "include_category",
              "exclude_category",
              "must_be_open",
              "max_distance"
            ],
            "title": "Kind",
            "type": "string"
          },
          "label": {
            "title": "Label",
            "type": "string"
          },
          "source": {
            "enum": [
              "ui",
              "text"
            ],
            "title": "Source",
            "type": "string"
          },
          "value": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "boolean"
              }
            ],
            "title": "Value"
          }
        },
        "required": [
          "kind",
          "value",
          "source",
          "label"
        ],
        "title": "AppliedConstraint",
        "type": "object"
      },
      "ComponentStatus": {
        "additionalProperties": false,
        "properties": {
          "detail": {
            "title": "Detail",
            "type": "string"
          },
          "status": {
            "enum": [
              "ok",
              "degraded",
              "unavailable",
              "not_configured"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "detail"
        ],
        "title": "ComponentStatus",
        "type": "object"
      },
      "Constraints": {
        "additionalProperties": false,
        "description": "Explicit user controls. These are the source of truth and override LLM guesses.",
        "properties": {
          "exclude_categories": {
            "items": {
              "enum": [
                "cafe",
                "food",
                "park",
                "culture",
                "attraction",
                "playground",
                "mall"
              ],
              "type": "string"
            },
            "maxItems": 7,
            "title": "Exclude Categories",
            "type": "array"
          },
          "exclude_place_ids": {
            "items": {
              "type": "string"
            },
            "maxItems": 20,
            "title": "Exclude Place Ids",
            "type": "array"
          },
          "include_categories": {
            "items": {
              "enum": [
                "cafe",
                "food",
                "park",
                "culture",
                "attraction",
                "playground",
                "mall"
              ],
              "type": "string"
            },
            "maxItems": 7,
            "title": "Include Categories",
            "type": "array"
          },
          "max_distance_m": {
            "anyOf": [
              {
                "maximum": 10000.0,
                "minimum": 100.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Distance M"
          },
          "must_be_open": {
            "default": false,
            "title": "Must Be Open",
            "type": "boolean"
          },
          "preferred_features": {
            "items": {
              "enum": [
                "socket",
                "wifi",
                "outdoor_seating",
                "wheelchair",
                "indoor",
                "kids"
              ],
              "type": "string"
            },
            "maxItems": 6,
            "title": "Preferred Features",
            "type": "array"
          },
          "required_features": {
            "items": {
              "enum": [
                "socket",
                "wifi",
                "outdoor_seating",
                "wheelchair",
                "indoor",
                "kids"
              ],
              "type": "string"
            },
            "maxItems": 6,
            "title": "Required Features",
            "type": "array"
          }
        },
        "title": "Constraints",
        "type": "object"
