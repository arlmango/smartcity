            "minimum": 10.0,
            "title": "Time Budget Min",
            "type": "integer"
          },
          "travel_mode": {
            "const": "walking",
            "default": "walking",
            "title": "Travel Mode",
            "type": "string"
          }
        },
        "required": [
          "origin",
          "time_budget_min",
          "client_request_id"
        ],
        "title": "RecommendRequest",
        "type": "object"
      },
